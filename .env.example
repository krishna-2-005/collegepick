# Copy to .env and fill in real values. Never commit .env.

# Postgres. Local: `docker compose up -d` and use the values below.
# Neon: DATABASE_URL is the pooled (-pooler) string, DIRECT_URL the direct one (used by migrations).
DATABASE_URL="postgresql://collegepick:collegepick@localhost:5433/collegepick"
DIRECT_URL="postgresql://collegepick:collegepick@localhost:5433/collegepick"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
